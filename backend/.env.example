# AppSuite Backend Configuration
# Copy this file to '.env' and fill in your production values.

# MySQL Database
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_DATABASE=smart_store
MYSQL_POOL_SIZE=10

# Server & CORS
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# JWT Authentication (Generate a strong random secret for production!)
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Optional On-Premise Project Storage (leave unset for Cloud SaaS)
PROJECTS_BASE_DIR=
